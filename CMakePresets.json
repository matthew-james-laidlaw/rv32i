{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_ACCEPTANCE_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 0
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "name": "debug", "type": "configure" },
        { "name": "debug", "type": "build" },
        { "name": "debug", "type": "test" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "name": "release", "type": "configure" },
        { "name": "release", "type": "build" },
        { "name": "release", "type": "test" }
      ]
    }
  ]
}
