{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (with acceptance tests)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RV32I_BUILD_ACCEPTANCE_TESTS": "ON"
      }
    },
    {
      "name": "no-acceptance",
      "displayName": "Without acceptance tests",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-no-acceptance",
      "cacheVariables": {
        "RV32I_BUILD_ACCEPTANCE_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "no-acceptance",
      "configurePreset": "no-acceptance"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "no-acceptance",
      "configurePreset": "no-acceptance",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
